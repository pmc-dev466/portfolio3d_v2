Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.idea/
.vscode/
*.swp
*~

# ── Registros ─────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
